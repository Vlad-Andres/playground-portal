GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Generation runs only when this is "true" AND PORTAL_ACCESS_CODE has 12+ characters.
PORTAL_ENABLE_GENERATION=false
# Use only for local testing; never enable in production.
PORTAL_FAKE_MODEL=false
# Shared invite code users type on the form. Any long random text.
PORTAL_ACCESS_CODE=
# Jobs accepted per UTC day (default 10).
PORTAL_DAILY_JOB_LIMIT=10
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Password for /admin (24+ characters). Without it /admin does not exist.
ADMIN_TOKEN=
